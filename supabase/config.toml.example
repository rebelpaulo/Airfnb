# supabase/config.toml.example
# Copy to config.toml after `supabase init`.
project_id = "airfnb"

[functions.send-email]
verify_jwt = true   # only callers with a valid Supabase JWT can invoke (use service_role from server)

[functions.stripe-webhook]
verify_jwt = false  # Stripe will not send a Supabase JWT — signature is validated inside the function

# Set secrets from a local, untracked file rather than shell-history values:
#   supabase secrets set --env-file <local-secrets-file>
# Required keys: RESEND_API_KEY, FROM_EMAIL, ALLOWED_TEMPLATES,
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET.
