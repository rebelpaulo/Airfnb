# Browser/server Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin. Production must be the approved public HTTPS origin.
APP_URL=http://localhost:3001

# Public pages accept plain mailbox addresses only (no display-name form).
# If a specialised address is blank, SUPPORT_EMAIL is used; if that is also
# blank, the public pages direct visitors to /ajuda without showing a fake email.
SUPPORT_EMAIL=
PARTNERSHIP_EMAIL=
PRIVACY_EMAIL=
LEGAL_EMAIL=

# Partner-lead notification fallbacks. Admin platform settings take priority.
PARTNER_EMAIL_VENUES=
PARTNER_EMAIL_GUEST_MGMT=
PARTNER_EMAIL_MUSIC=
PARTNER_EMAIL_MARKETING=

# Payments (server only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public form rate limiting. Falls back to SUPABASE_SERVICE_ROLE_KEY, but a
# dedicated high-entropy value keeps the two responsibilities separate.
PUBLIC_RATE_LIMIT_SECRET=

# Optional OAuth buttons: comma-separated subset of google,apple.
NEXT_PUBLIC_OAUTH_PROVIDERS=

# Supabase Edge Function secrets (set with `supabase secrets set`; do not add
# these to the Vercel allowlist unless a Vercel runtime starts consuming them).
RESEND_API_KEY=
FROM_EMAIL=
ALLOWED_TEMPLATES=booking_inquiry_received,proposal_sent,booking_confirmed,booking_cancelled,payment_received,review_request,contact_reply,newsletter_confirm

# scripts/vercel-env-bootstrap.sh configuration. VERCEL_TOKEN is deliberately
# accepted from the invoking shell only and must not be stored in this file.
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_ENV_TARGETS=production,preview,development
VERCEL_ENV_ALLOWLIST=
VERCEL_PLAIN_ENV_KEYS=
